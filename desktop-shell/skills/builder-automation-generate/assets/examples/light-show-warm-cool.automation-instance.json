{
  "metadata": {
    "name": "客厅冷暖潮汐",
    "description": "灯光从暖黄走到冷白再回来。"
  },
  "automations": [
    {
      "name": "客厅冷暖潮汐",
      "starters": [{ "type": "manual", "name": "客厅冷暖潮汐" }],
      "actions": [
        {
          "type": "device.trait.write",
          "functionCode": "Output",
          "traitCode": "OnOff",
          "targets": [{ "deviceId": "dev.living.light", "endpointIds": [1] }],
          "value": true
        },
        {
          "type": "device.trait.write",
          "functionCode": "LevelControl",
          "traitCode": "CurrentLevel",
          "targets": [{ "deviceId": "dev.living.light", "endpointIds": [1] }],
          "value": 70
        },
        {
          "type": "device.trait.write",
          "functionCode": "ColorControl",
          "traitCode": "ColorTemperature",
          "targets": [{ "deviceId": "dev.living.light", "endpointIds": [1] }],
          "value": 370
        },
        { "type": "delay", "for": "3sec" },
        {
          "type": "device.trait.write",
          "functionCode": "ColorControl",
          "traitCode": "ColorTemperature",
          "targets": [{ "deviceId": "dev.living.light", "endpointIds": [1] }],
          "value": 250
        },
        { "type": "delay", "for": "3sec" },
        {
          "type": "device.trait.write",
          "functionCode": "ColorControl",
          "traitCode": "ColorTemperature",
          "targets": [{ "deviceId": "dev.living.light", "endpointIds": [1] }],
          "value": 153
        },
        { "type": "delay", "for": "3sec" },
        {
          "type": "device.trait.write",
          "functionCode": "ColorControl",
          "traitCode": "ColorTemperature",
          "targets": [{ "deviceId": "dev.living.light", "endpointIds": [1] }],
          "value": 370
        }
      ]
    }
  ]
}
