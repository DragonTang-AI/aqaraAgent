{
  "metadata": {
    "name": "客厅灯光呼吸",
    "description": "灯由暗到亮再回到暗，像呼吸一样。"
  },
  "automations": [
    {
      "name": "客厅灯光呼吸",
      "starters": [{ "type": "manual", "name": "客厅灯光呼吸" }],
      "actions": [
        {
          "type": "device.trait.write",
          "functionCode": "Output",
          "traitCode": "OnOff",
          "targets": [{ "deviceId": "dev.living.light", "endpointIds": [1] }],
          "value": true
        },
        {
          "type": "device.trait.write",
          "functionCode": "LevelControl",
          "traitCode": "CurrentLevel",
          "targets": [{ "deviceId": "dev.living.light", "endpointIds": [1] }],
          "value": 15
        },
        { "type": "delay", "for": "2sec" },
        {
          "type": "device.trait.write",
          "functionCode": "LevelControl",
          "traitCode": "CurrentLevel",
          "targets": [{ "deviceId": "dev.living.light", "endpointIds": [1] }],
          "value": 45
        },
        { "type": "delay", "for": "2sec" },
        {
          "type": "device.trait.write",
          "functionCode": "LevelControl",
          "traitCode": "CurrentLevel",
          "targets": [{ "deviceId": "dev.living.light", "endpointIds": [1] }],
          "value": 85
        },
        { "type": "delay", "for": "2sec" },
        {
          "type": "device.trait.write",
          "functionCode": "LevelControl",
          "traitCode": "CurrentLevel",
          "targets": [{ "deviceId": "dev.living.light", "endpointIds": [1] }],
          "value": 45
        },
        { "type": "delay", "for": "2sec" },
        {
          "type": "device.trait.write",
          "functionCode": "LevelControl",
          "traitCode": "CurrentLevel",
          "targets": [{ "deviceId": "dev.living.light", "endpointIds": [1] }],
          "value": 20
        }
      ]
    }
  ]
}
