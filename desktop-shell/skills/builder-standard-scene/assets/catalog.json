{
  "version": "1.2.4",
  "note": "销售简化版：按空间召回**全部**相关设备；氛围类焦点开+其余关；mutex_group 为产品层软互斥（Studio create_scene 暂无原生互斥字段）。",
  "mutex_groups": {
    "living_state": "客厅灯光/氛围态互斥（会客/全开/全关/冷暖/亮度/观影/离开）",
    "dining_state": "餐厅就餐态互斥（备餐/就餐）",
    "bedroom_state": "卧室作息态互斥（早安/晚安/起夜/离开）",
    "entry_whole": "出门与全屋昼夜互斥（回家/离家/白天/晚上）",
    "bath_presence": "卫生间人感开灯态",
    "kitchen_state": "厨房人感开灯与告警",
    "corridor_presence": "走廊人感开灯态"
  },
  "categories": [
    {
      "id": "entry",
      "label": "玄关",
      "send": "按标准场景选类玄关",
      "match": {"names": ["玄关", "入户", "门厅", "entry", "foyer"]},
      "pages": [["huijia", "lijia"]]
    },
    {
      "id": "living",
      "label": "客厅",
      "send": "按标准场景选类客厅",
      "match": {"names": ["客厅", "起居", "living", "lounge"]},
      "pages": [
        ["huike", "guanying", "living_all_on"],
        ["living_all_off", "living_cool", "living_warm"],
        ["living_50", "living_25", "living_leave"],
        ["pinjian", "mingxiang", "party"],
        ["living_read"]
      ]
    },
    {
      "id": "dining",
      "label": "餐厅",
      "send": "按标准场景选类餐厅",
      "match": {"names": ["餐厅", "餐桌", "dining"]},
      "pages": [["beican", "jiucan", "langman"]]
    },
    {
      "id": "bedroom",
      "label": "卧室",
      "send": "按标准场景选类卧室",
      "match": {"names": ["卧室", "主卧", "次卧", "儿童房", "主人房", "bedroom"]},
      "pages": [["bedroom_leave", "zaoan", "wanan"], ["qiye", "huifang"]]
    },
    {
      "id": "bath",
      "label": "卫生间",
      "send": "按标准场景选类卫生间",
      "match": {"names": ["卫生间", "浴室", "洗漱", "toilet", "bath"]},
      "pages": [["muyu", "xishu", "ruce"], ["bath_presence"]]
    },
    {
      "id": "kitchen",
      "label": "厨房",
      "send": "按标准场景选类厨房",
      "match": {"names": ["厨房", "橱柜", "kitchen"]},
      "pages": [["kitchen_presence", "kitchen_alert"]]
    },
    {
      "id": "corridor",
      "label": "走廊",
      "send": "按标准场景选类走廊",
      "match": {"names": ["走廊", "过道", "corridor", "hallway"]},
      "pages": [["corridor_presence"]]
    },
    {
      "id": "reading",
      "label": "阅读区",
      "match": {"names": ["阅读", "书房", "书桌", "reading", "study"]},
      "pages": [["reading_on", "reading_off"]]
    },
    {
      "id": "generic",
      "label": "通用空间",
      "fallback": true,
      "pages": [["generic_all_on", "generic_all_off"]]
    },
    {
      "id": "whole",
      "label": "全屋",
      "send": "按标准场景选类全屋",
      "pages": [["day_mode", "night_mode"]]
    }
  ],
  "category_pages": [
    ["entry", "living", "dining"],
    ["bedroom", "bath", "kitchen"],
    ["corridor", "whole"]
  ],
