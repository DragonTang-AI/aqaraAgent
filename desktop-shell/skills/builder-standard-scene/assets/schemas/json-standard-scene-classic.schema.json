{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "json-standard-scene-classic",
  "title": "json.standard_scene classic JSON_SCENE",
  "type": "object",
  "required": ["name", "configFormat", "config"],
  "properties": {
    "sceneId": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "createTime": { "type": "string" },
    "configFormat": { "const": "JSON_SCENE" },
    "config": {
      "type": "object",
      "required": ["metadata", "actions"],
      "properties": {
        "metadata": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "scope": { "type": "array" },
            "variables": { "type": "array" },
            "description": { "type": "string" }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object" }
        }
      }
    }
  }
}
